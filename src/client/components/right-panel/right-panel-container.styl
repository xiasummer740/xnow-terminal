/* RightPanelContainer - 右侧停靠面板（压缩终端宽度） */

.right-panel-overlay-container
  position absolute
  right 0
  top 36px
  bottom 36px  /* 留出底部 footer 空间，不遮挡 Info 按钮 */
  z-index 200
  display flex
  flex-direction row

.rp-panel
  height 100%
  overflow hidden
  background var(--main)
  color var(--text)
  border-left 1px solid var(--main-darker)

.rp-drag-handle
  width 4px
  cursor col-resize
  background transparent
  flex-shrink 0
  transition background 0.15s
  &:hover
    background var(--primary)
    opacity 0.6

/* 面板内部布局 */
.right-panel
  display flex
  flex-direction column
  height 100%

.right-panel-titlebar
  display flex
  align-items center
  justify-content space-between
  padding 0 12px
  height 40px
  border-bottom 1px solid var(--main-darker)
  flex-shrink 0

.right-panel-title
  font-size 13px
  font-weight 600
  color var(--text)
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.right-panel-controls
  display flex
  align-items center
  gap 4px

.right-panel-close-btn
  font-size 16px
  color var(--text-dark)
  cursor pointer
  padding 4px
  -webkit-app-region no-drag
  &:hover
    color var(--error)

// 面板标题栏可拖动窗口（app-drag class 由 React 组件添加）
.app-drag
  -webkit-app-region drag

.no-drag
  -webkit-app-region no-drag

.right-panel-content
  flex 1
  overflow-y auto
  padding 0
