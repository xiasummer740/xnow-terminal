
.tabs
  position relative
  height 36px
  overflow hidden
  background var(--main-dark)
  z-index 12
  ::-webkit-scrollbar
    width 0
    display none
.not-system-ui.is-mac .layout-item.v1 .tabs-inner
  margin-left 42px
.not-system-ui.is-mac.not-webapp .layout-item.v1
  .tabs-inner
    margin-left 72px
.not-system-ui.is-mac.not-webapp.pinned .layout-item.v1
  .tabs-inner
    margin-left 0
.not-system-ui.not-mac.not-webapp
  .tabs-extra
    right 96px
.tabs-inner
  position relative
  z-index 2
  padding 0
  margin-top 0
  display inline-block
  height 36px
  overflow-x scroll
  overflow-y hidden

.tabs-wrapper
  z-index 3
.tab
  display inline-block
  vertical-align middle
  cursor pointer
  position relative
  padding 0 14px
  min-width 40px
  max-width 160px
  line-height 36px
  margin 0 1px 0 0
  border-radius 3px 3px 0 0
  background var(--main-dark)
  text-align center
  color var(--text-dark)
  &.tab-last
    margin-right 5px
  .tab-close
    visibility hidden
  &.active
    color var(--text)
    background var(--main)
  &.active-all
    font-weight 700
    background linear-gradient(135deg, rgba(24,144,255,0.2) 0%, rgba(180,60,255,0.25) 50%, rgba(24,144,255,0.2) 100%)
    background-size 200% 200%
    animation gradientFlow 3s ease infinite
    .tab-count
      border-radius 15px
      font-weight bold
  &:not(.active-all)
    transition background 0.3s ease
  &:hover
    .tab-close
      visibility visible
  &.dragover-tab::after
    position absolute
    content ''
    left -2px
    top -0.5px
    bottom -0.5px
    width 2px
    background var(--border-active)

@keyframes blink
  0%
    background-color #e0e0e0
  50%
    background-color #ffffff
  100%
    background-color #e0e0e0

@keyframes gradientFlow
  0%
    background-position 0% 50%
  50%
    background-position 100% 50%
  100%
    background-position 0% 50%

.tab-traffic
  position absolute
  left 10px
  top 2px
  width 5px
  height 5px
  border-radius 5px
  background-color var(--text-dark)
.tab-status
  position absolute
  left 2px
  top 2px
  width 5px
  height 5px
  border-radius 5px
  background-color var(--text-dark)
  &.success
    background-color var(--success)
  &.error
    background-color var(--error)
  &.processing
    background-color var(--primary)
.tab-terminal-feed
  position absolute
  left 50%
  margin-left -8px
  bottom 2px
  animation feedPulse 2s ease infinite

@keyframes feedPulse
  0%
    opacity 1
  50%
    opacity 0.5
  100%
    opacity 1

.tab-close
  position absolute
  right 5px
  cursor pointer
  top 50%
  margin-top -7px
  background var(--main)
  padding 0 2px
  border-radius 50%
  font-size 10px
  color var(--text-dark)
  &:hover
    color var(--text-light)

.tab-status
  display none

.tab-reload
  display inline-block
  margin-right 5px
  font-size 12px
  color #d49a4 !important

.tab-title-tag
  margin-right 5px
  font-size 14px

.tab-count
  border-radius 10px 2px 2px 10px
  margin-right 4px
  min-width 18px
  text-align center
  font-size 10px
  display inline-block

.tab-title
  display inline
  font-size 13px
  overflow hidden
  white-space nowrap
  text-overflow ellipsis
  max-width 120px

.tab-traffic
  display inline

.tabs-extra
  position absolute
  right 0
  bottom 0
  display flex
  align-items center
  height 36px
  padding 0 5px
  background var(--main-dark)
  box-shadow -6px 0 6px var(--main-dark)
  z-index 3

.tab-scroll-icon
  color var(--text-dark)
  &:hover
    color var(--text)

.tabs-dd-icon
  color var(--text-dark)
  &:hover
    color var(--text)

.tabs-add-btn
  color var(--text-dark)
  &:hover
    color var(--text)

.not-system-ui.not-mac.not-webapp
  .tab-close
  .tab-reload
  .tabs-extra
    -webkit-app-region no-drag
