.no-sessions
  position absolute
  top 34px
  left 0
  right 0
  bottom 0
  z-index 11
  display flex
  align-items center
  justify-content center
  background var(--main)

.no-session-inner
  display flex
  flex-direction column
  align-items center
  gap 20px
  max-width 480px
  width 100%
  padding 0 24px

/* 品牌区 */
.no-session-brand
  text-align center
  margin-bottom 8px

.no-session-logo
  margin-bottom 12px

.no-session-logo-img
  width 48px
  height 48px
  object-fit contain

.no-session-title
  font-size 28px
  font-weight 600
  color var(--text)
  margin 0 0 8px 0
  letter-spacing 1px

.no-session-version
  margin-bottom 12px

.no-session-subtitle
  font-size 14px
  color var(--text-dark)
  margin 0

/* 快速连接输入 */
.no-session-quick-connect
  width 100%

.no-session-input-row
  display flex
  gap 8px

.no-session-input
  flex 1
  height 44px !important
  font-size 14px !important
  border-radius 8px !important
  :where(.ant-input-outlined)
    border-color var(--border)
    &:hover, &:focus
      border-color var(--primary)
      box-shadow 0 0 0 2px rgba(24, 144, 255, 0.1)

.no-session-hint
  font-size 12px
  color var(--text-dark)
  margin-top 6px
  padding-left 4px

/* 快速模板按钮组 */
.no-session-templates
  display flex
  gap 10px
  flex-wrap wrap
  justify-content center

.no-session-template-btn
  display inline-flex
  align-items center
  gap 6px
  height 40px
  min-width 90px
  border-radius 8px
  border 1px solid var(--border)
  color var(--text)
  background var(--main-dark)
  font-size 13px
  transition all 0.2s ease
  &:hover
    border-color var(--primary)
    color var(--primary)
    background rgba(24, 144, 255, 0.06)
    transform translateY(-1px)
  &:active
    transform translateY(0)
