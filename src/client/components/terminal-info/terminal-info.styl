.terminal-info-icon
  color var(--text-dark)
  &:hover
    color var(--text)

.info-panel-wrap
  position fixed
  right 0
  top 100px
  bottom 0
  width 500px
  background var(--main)
  border-left 1px solid var(--main-darker)
  color var(--text)
  z-index 100
  overflow-y auto

  .drag-handle
    left 0
    right auto
    display block

  // 毛玻璃顶部标题
  .info-panel-header
    position sticky
    top 0
    z-index 10
    background rgba(10, 14, 26, 0.85)
    backdrop-filter blur(12px)
    border-bottom 1px solid rgba(255,255,255,0.06)
    padding 12px 16px

  // 仪表盘四卡片网格
  .gauge-grid
    display grid
    grid-template-columns 1fr 1fr
    gap 8px
    padding 0 12px
    margin-bottom 12px

  .gauge-card
    background rgba(255,255,255,0.03)
    border 1px solid rgba(255,255,255,0.06)
    border-radius 10px
    padding 12px
    text-align center
    transition all 0.2s
    &:hover
      background rgba(255,255,255,0.06)
      border-color rgba(255,255,255,0.1)
      transform translateY(-1px)

  // 区块标题
  .section-title
    font-size 11px
    font-weight 600
    text-transform uppercase
    letter-spacing 1px
    color rgba(255,255,255,0.35)
    padding 8px 16px 4px

  // 网络流量表
  .net-table
    width 100%
    border-collapse collapse
    font-size 12px
    th
      text-align left
      color rgba(255,255,255,0.3)
      font-weight 500
      font-size 10px
      text-transform uppercase
      letter-spacing 0.5px
      padding 4px 12px
      border-bottom 1px solid rgba(255,255,255,0.06)
    td
      padding 6px 12px
      border-bottom 1px solid rgba(255,255,255,0.03)
      font-family 'Maple Mono', monospace
      font-size 11px

  // 进程列表
  .proc-table
    width 100%
    border-collapse collapse
    font-size 11px
    th
      text-align left
      color rgba(255,255,255,0.3)
      font-weight 500
      font-size 10px
      text-transform uppercase
      letter-spacing 0.5px
      padding 4px 12px
      border-bottom 1px solid rgba(255,255,255,0.06)
    td
      padding 5px 12px
      border-bottom 1px solid rgba(255,255,255,0.03)
      font-family 'Maple Mono', monospace
      font-size 11px
    tr:hover td
      background rgba(255,255,255,0.02)

  // 信息行（ID、运行时间等）
  .info-line
    display flex
    justify-content space-between
    align-items center
    padding 4px 16px
    font-size 12px
    .label
      color rgba(255,255,255,0.4)
    .value
      color var(--text)
      font-family 'Maple Mono', monospace
      font-size 11px

.terminal-info-section
  padding 6px 0

.terminal-info-act,
.terminal-info-disk,
.terminal-info-network
  max-height 200px
  overflow-y auto

  &::-webkit-scrollbar
    width 4px
  &::-webkit-scrollbar-thumb
    background rgba(255,255,255,0.1)
    border-radius 2px

.activity-item
  max-height 1.6em
  line-height 1.6
  overflow hidden
  &:hover
    max-height none

.info-panel-wrap-pin
  .toggle-info-panel-wrap
    color var(--success)

// CPU 历史图
.cpu-chart-wrap
  padding 0 12px
  margin-bottom 8px
