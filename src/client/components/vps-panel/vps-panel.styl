/* VPS Info Panel 样式 - 显示系统信息/TerminalInfo */

.right-panel-vps
  .right-panel-content
    padding 0
    overflow-y auto

  // TerminalInfo 内部样式覆盖 - 适配窄面板
  .info-item
    font-size 12px

  .info-label
    font-size 11px

// IP 地址徽标（标题栏右侧可复制）
.vps-host-badge
  font-size 12px
  font-weight normal
  color var(--text-dark)
  margin-left 8px
  cursor pointer
  padding 2px 6px
  border-radius 3px
  background var(--main-darker)
  &:hover
    color var(--primary)
    background var(--main-dark)
