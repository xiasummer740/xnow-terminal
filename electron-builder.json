{
  "appId": "com.xnow.terminal",
  "productName": "XNOW Terminal",
  "directories": {
    "app": "work/app",
    "output": "dist"
  },
  "icon": "xnow-logo.png",
  "files": [
    "**/*"
  ],
  "npmRebuild": false,
  "win": {
    "target": "nsis",
    "icon": "xnow-logo.png",
    "publish": {
      "provider": "github",
      "owner": "xiasummer740",
      "repo": "xnow-terminal"
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "XNOW-Terminal-${version}-win-x64-installer.${ext}",
    "deleteAppDataOnUninstall": false
  }
}
